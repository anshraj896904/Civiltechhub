rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserStudyProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.selectedDiplomaTrack is string && data.selectedDiplomaTrack.size() >= 1 && data.selectedDiplomaTrack.size() <= 60 &&
             data.preferredSoftwareVersion is string && data.preferredSoftwareVersion.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudBookmarkedCommand(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.software is string && data.software.size() >= 1 && data.software.size() <= 100 &&
             data.versionScope is string && data.versionScope.size() >= 1 && data.versionScope.size() <= 100 &&
             data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 200 &&
             data.command is string && data.command.size() >= 1 && data.command.size() <= 500 &&
             data.shortcut is string && data.shortcut.size() >= 1 && data.shortcut.size() <= 200 &&
             data.menuPath is string && data.menuPath.size() >= 1 && data.menuPath.size() <= 500 &&
             data.siteExample is string && data.siteExample.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudInterviewAttempt(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
             data.questionType is string && data.questionType.size() >= 1 && data.questionType.size() <= 60 &&
             data.question is string && data.question.size() >= 1 && data.question.size() <= 1000 &&
             data.userAnswer is string && data.userAnswer.size() >= 1 && data.userAnswer.size() <= 2000 &&
             data.score is int && data.score >= 0 && data.score <= 10 &&
             data.whatWasGood is string && data.whatWasGood.size() <= 1500 &&
             data.betterSampleAnswer is string && data.betterSampleAnswer.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'selectedDiplomaTrack', 'preferredSoftwareVersion', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'selectedDiplomaTrack', 'preferredSoftwareVersion', 'createdAt', 'updatedAt']) &&
                       isValidUserStudyProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidUserStudyProfile(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'selectedDiplomaTrack', 'preferredSoftwareVersion', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /bookmarked_commands/{commandId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(commandId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(commandId) &&
                         request.auth.uid == userId &&
                         incoming().id == commandId &&
                         incoming().keys().hasAll(['id', 'userId', 'software', 'versionScope', 'taskTitle', 'command', 'shortcut', 'menuPath', 'siteExample', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'software', 'versionScope', 'taskTitle', 'command', 'shortcut', 'menuPath', 'siteExample', 'createdAt', 'updatedAt']) &&
                         isValidCloudBookmarkedCommand(incoming());

        allow update: if isSignedIn() &&
                         isValidCloudBookmarkedCommand(incoming()) &&
                         isValidId(userId) &&
                         isValidId(commandId) &&
                         request.auth.uid == userId &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['software', 'versionScope', 'taskTitle', 'command', 'shortcut', 'menuPath', 'siteExample', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(commandId) && request.auth.uid == userId;
      }

      match /interview_attempts/{attemptId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(attemptId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(attemptId) &&
                         request.auth.uid == userId &&
                         incoming().id == attemptId &&
                         incoming().keys().hasAll(['id', 'userId', 'topic', 'questionType', 'question', 'userAnswer', 'score', 'whatWasGood', 'betterSampleAnswer', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'topic', 'questionType', 'question', 'userAnswer', 'score', 'whatWasGood', 'betterSampleAnswer', 'createdAt', 'updatedAt']) &&
                         isValidCloudInterviewAttempt(incoming());

        allow update: if isSignedIn() &&
                         isValidCloudInterviewAttempt(incoming()) &&
                         isValidId(userId) &&
                         isValidId(attemptId) &&
                         request.auth.uid == userId &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['userAnswer', 'score', 'whatWasGood', 'betterSampleAnswer', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(attemptId) && request.auth.uid == userId;
      }
    }
  }
}
